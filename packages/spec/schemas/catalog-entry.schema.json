{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Angelguirao/meta-harness/packages/spec/schemas/catalog-entry.schema.json",
  "title": "OOCS catalog entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectId", "name", "lane", "covers"],
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "enum": ["core", "watch", "adjacent", "reference"]
    },
    "covers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["featureId", "level"],
        "properties": {
          "featureId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "level": {
            "type": "string",
            "enum": ["claimed", "documented", "evidenced"]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "quote": { "type": "string" },
              "accessed": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            }
          }
        }
      }
    }
  }
}
