---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  CORE_OS,
  CORE_WATCH,
  FEATURES,
  PEERS,
  LANES,
  REFERENCES,
  peersInLane,
} from "../data/landscape.js";

const neighborLanes = LANES.filter((l) => !l.quiet)
  .map((l) => ({ ...l, peers: peersInLane(l.id) }))
  .filter((l) => l.peers.length);
const elsewhere = LANES.filter((l) => l.quiet).flatMap((l) =>
  peersInLane(l.id),
);

const sources = [
  ...REFERENCES.map((r) => ({ name: r.name, url: r.url })),
  ...CORE_OS.map((s) => ({ name: s.name, url: s.url })),
  { name: CORE_WATCH.name, url: CORE_WATCH.url },
  ...PEERS.filter((p) => p.url).map((p) => ({
    name: p.name === "Cerebras Knowledge" ? "Cerebras" : p.name,
    url: p.url,
  })),
];
---

<BaseLayout>
  <header class="top">
    <span class="top-meta">field notes · operator OS</span>
    <nav class="top-nav" aria-label="On this page">
      <a href="#define">define</a>
      <a href="#os">os</a>
      <a href="#features">features</a>
      <a href="#field">field</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero">
      <h1 class="brand">meta<span class="brand-hyphen">-</span>harness</h1>
      <p class="lede">
        An operator OS for a fleet of agents — define roles, assign work,
        isolate permissions, walk away. The harness underneath is muscle.
      </p>
      <div class="stack" aria-label="OS over muscle">
        <div class="stack-row stack-shop">
          <span class="stack-k">os</span>
          <span class="stack-v"
            >roles · work · policy · sessions · memory<span
              class="cursor"
              aria-hidden="true"></span></span
          >
        </div>
        <div class="stack-row stack-muscle">
          <span class="stack-k">muscle</span>
          <span class="stack-v"
            >claude code · codex · pi · voice workers · …</span
          >
        </div>
      </div>
    </section>

    <section class="prose" id="define" aria-labelledby="define-title">
      <h2 id="define-title" class="sr-only">Definition</h2>
      <p class="punch">
        A harness runs one loop. Real work crosses agents, sessions, and hands.
        Without an OS above it, you are the scheduler, the vault, and the
        memory — until the chat dies.
      </p>
      <p class="why-cite">
        <a href="https://metaharness.tools/">metaharness.tools</a> named the
        gap. Operator OSes are forming inside it — coding or not. Vertical does
        not decide membership.
      </p>
    </section>

    <section class="core-os" id="os" aria-labelledby="os-title">
      <h2 id="os-title">Operator OS</h2>
      <p class="section-dek">
        Same lane under the definition — claim multi-agent fleet control, not
        just a better loop.
      </p>
      <ul class="peer-list peer-list-dense core-list">
        {
          CORE_OS.map((os) => (
            <li>
              <div class="peer-head">
                <a
                  class="peer-name"
                  href={os.url}
                  target="_blank"
                  rel="noreferrer"
                >
                  {os.name}
                </a>
                <span class="peer-by">{os.by}</span>
              </div>
              <p class="peer-claim">{os.claim}</p>
              <p class="peer-hook">{os.hook}</p>
            </li>
          ))
        }
      </ul>
      <p class="watch-line">
        Watch:{" "}
        <a href={CORE_WATCH.url} target="_blank" rel="noreferrer"
          >{CORE_WATCH.name}</a
        >
        {" — "}
        {CORE_WATCH.hook}
      </p>
    </section>

    <section class="features" id="features" aria-labelledby="features-title">
      <h2 id="features-title">Features</h2>
      <p class="section-dek">
        How each OS approaches the surface — prose, not a coverage matrix.
      </p>
      {
        FEATURES.map((feat) => (
          <div class="feature-block" id={feat.id}>
            <h3 class="feature-title">{feat.title}</h3>
            <p class="feature-dek">{feat.dek}</p>
            <ul class="approach-list">
              {feat.approaches.map((a) => (
                <li>
                  <a
                    class="approach-who"
                    href={a.url}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {a.name}
                  </a>
                  <span class="approach-how">{a.approach}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="features-note">
        Blueprint only:{" "}
        <a
          href="https://gist.github.com/iannuttall/8152098b5ce8e6c1a7499ee561ed93f4"
          target="_blank"
          rel="noreferrer">Postma / Ian Nuttall AgentOS</a
        >
        — fullest written spec of roles, Kanban, goals, deny-by-default, and
        ephemeral sessions. Not a shipped peer.
      </p>
    </section>

    <section class="field" id="field" aria-labelledby="field-title">
      <h2 id="field-title">Field</h2>
      <p class="section-dek">
        Layers around the OS — by claim, not by industry.
      </p>
      {
        neighborLanes.map((lane) => (
          <div class="lane-block">
            <h3 class="lane-title">{lane.title}</h3>
            <p class="lane-dek">{lane.dek}</p>
            <ul class="peer-list peer-list-dense">
              {lane.peers.map((p) => (
                <li>
                  <div class="peer-head">
                    <a
                      class="peer-name"
                      href={p.url}
                      target="_blank"
                      rel="noreferrer"
                    >
                      {p.name}
                    </a>
                    <span class="peer-by">{p.by}</span>
                  </div>
                  <p class="peer-hook">{p.hook}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="elsewhere-line">
        Elsewhere:{" "}
        {
          elsewhere.map((p, i) => (
            <>
              {i > 0 ? " · " : ""}
              <a href={p.url} target="_blank" rel="noreferrer">
                {p.name}
              </a>
            </>
          ))
        }
        {" "}
        — harness-code search, company brain, CX/CRM platforms, personal intent
        layers, desktop coworkers.
      </p>
      <p class="coda">Until the OS exists, you are it.</p>
    </section>
  </main>

  <footer class="foot">
    <p class="foot-sources">
      {
        sources.map((s) => (
          <a href={s.url} target="_blank" rel="noreferrer">
            {s.name}
          </a>
        ))
      }
    </p>
    <p class="foot-meta">
      Updated 2026-08-15 · field notes · MIT ·
      <a href="https://github.com/Angelguirao/meta-harness">source</a>
    </p>
  </footer>

  <script>
    const links = [...document.querySelectorAll(".top-nav a[href^='#']")];
    const sections = links
      .map((a) => document.querySelector(a.getAttribute("href") || ""))
      .filter((el) => el instanceof HTMLElement);

    const setActive = (id) => {
      links.forEach((a) => {
        a.classList.toggle("is-active", a.getAttribute("href") === `#${id}`);
      });
    };

    if ("IntersectionObserver" in window && sections.length) {
      const visible = new Map();
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) visible.set(e.target, e.intersectionRatio);
          let best = null;
          let bestRatio = 0;
          for (const s of sections) {
            const r = visible.get(s) || 0;
            if (r > bestRatio) {
              bestRatio = r;
              best = s;
            }
          }
          if (best && bestRatio > 0) setActive(best.id);
        },
        {
          rootMargin: "-20% 0px -55% 0px",
          threshold: [0, 0.25, 0.5, 0.75, 1],
        },
      );
      sections.forEach((s) => io.observe(s));
    } else {
      const sync = () => {
        const y = window.scrollY + 96;
        let current = sections[0];
        for (const s of sections) {
          if (s.offsetTop <= y) current = s;
        }
        setActive(current?.id ?? null);
      };
      sync();
      window.addEventListener("scroll", sync, { passive: true });
    }
  </script>
</BaseLayout>
