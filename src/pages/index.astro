---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PARTS, PEERS, LANES, peersInLane } from "../data/landscape.js";

const tbd = PEERS.find((p) => p.self);
const fieldLanes = LANES.filter((l) => peersInLane(l.id).length > 0);
---

<BaseLayout>
  <header class="top">
    <span class="top-meta">research · v0</span>
    <nav class="top-nav" aria-label="On this page">
      <a href="#why">why</a>
      <a href="#organs">organs</a>
      <a href="#field">field</a>
      <a href="#tbd">tbd</a>
      <a href="https://github.com/Angelguirao/meta-harness">github</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero">
      <p class="eyebrow">research · v0</p>
      <h1 class="brand">meta-harness</h1>
      <p class="lede">
        The coding agent is the muscle. Something else has to be the shop —
        or you are.
      </p>
    </section>

    <section class="prose" id="why" aria-labelledby="why-title">
      <h2 id="why-title">Why this exists</h2>
      <p>
        A harness (Claude Code, Codex, Pi, OpenCode) does one loop in one tree.
        Real work often isn’t one tree. Cancel-order needs API + web +
        design-system. You become the bus: clone, paste context, land three
        PRs. <a href="https://metaharness.tools/">metaharness.tools</a> named
        that gap; operators already live it.
      </p>
      <p>
        Git keeps the what. The session keeps the why. When the chat dies, so
        does the decision — until you burn another Tuesday rediscovering it.
      </p>
      <p class="punch">
        This notebook maps what people are shipping into that gap. Not a
        product. Not a pitch.
      </p>
    </section>

    <section class="prose" id="define" aria-labelledby="define-title">
      <h2 id="define-title">Two meanings, one word</h2>
      <p>
        <strong>Orchestration</strong> — layer above many harnesses: cross-repo,
        session memory, swap, sandbox, policy.
      </p>
      <p>
        <strong>Optimization</strong> — outer loop that searches over harness
        <em>code</em> (Stanford; SuperagenticAI). Same word. Different job.
      </p>
      <p>
        We care about orchestration. We read it as a
        <strong>bundle of organs</strong>, not one SKU. Peers harden different
        subsets. A knowledge base or issue graph can be an organ without being
        “the meta-harness.”
      </p>
    </section>

    <section class="organs" id="organs" aria-labelledby="organs-title">
      <h2 id="organs-title">Organs</h2>
      <p class="section-dek">If it’s missing, this is what breaks.</p>
      <ul class="organ-list">
        {
          PARTS.map((part) => (
            <li>
              <span class="organ-name">{part.label}</span>
              <span class="organ-miss">{part.miss}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="field" id="field" aria-labelledby="field-title">
      <h2 id="field-title">Field</h2>
      <p class="section-dek">
        One line each. Tags are our organ frame — not a vendor scorecard.
      </p>

      {
        fieldLanes.map((lane) => (
          <div class="lane">
            <h3 class="lane-title">{lane.title}</h3>
            <ul class="peer-list">
              {peersInLane(lane.id).map((p) => (
                <li>
                  <div class="peer-head">
                    <a class="peer-name" href={p.url} target="_blank" rel="noreferrer">
                      {p.name}
                    </a>
                    <span class="peer-by">{p.by}</span>
                    <span class="peer-organs">{p.organs.join(" · ")}</span>
                  </div>
                  <p class="peer-hook">{p.hook}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    {
      tbd && (
        <section class="tbd" id="tbd" aria-labelledby="tbd-title">
          <h2 id="tbd-title">TBD</h2>
          <p class="section-dek">Private stack. No public repo. No claim.</p>
          <p class="tbd-body">
            Working thesis: control plane + durable meaning sit heavy. Cross-repo
            scope, trusted handoff, and OS sandbox sit thin. Closest lane is org /
            workspace OS — not Polygraph, not Omnigent packaging.
          </p>
          <p class="tbd-bet">
            Open bet: harden one thin organ, or keep the asset as the world model
            that dispatches wraps.
          </p>
        </section>
      )
    }

    <section class="open" id="open" aria-labelledby="open-title">
      <h2 id="open-title">Open</h2>
      <ol>
        <li>
          After a three-repo change, what must stay queryable next week without
          re-explaining the why?
        </li>
        <li>Next thin organ: handoff, sandbox, or scope?</li>
        <li>
          If Polygraph + Omnigent + Beads + a retrieve organ covered the week,
          what is a private control plane still for?
        </li>
      </ol>
    </section>

    <section class="sources" id="sources" aria-labelledby="sources-title">
      <h2 id="sources-title">Sources</h2>
      <p class="sources-row">
        <a href="https://metaharness.tools/">metaharness.tools</a>
        <a href="https://trypolygraph.com/">Polygraph</a>
        <a href="https://omnigent.ai/">Omnigent</a>
        <a href="https://paperclip.ing/">Paperclip</a>
        <a href="https://blog.cloudflare.com/cloudflare-os/">Cloudflare OS</a>
        <a href="https://www.agno.com/">Agno</a>
        <a href="https://beads.gascity.com/">Beads</a>
        <a href="https://qm.ycombinator.com/">QM</a>
        <a href="https://www.cerebras.ai/blog/how-we-built-our-knowledge-base"
          >Cerebras</a
        >
        <a href="https://yoonholee.com/meta-harness/">Stanford</a>
        <a href="https://superagenticai.github.io/metaharness/">SuperagenticAI</a>
        <a href="https://github.com/andrewyng/openworker">OpenWorker</a>
      </p>
    </section>
  </main>

  <footer class="foot">
    <p>
      Labels move · MIT ·
      <a href="https://github.com/Angelguirao/meta-harness">source</a>
    </p>
  </footer>
</BaseLayout>
