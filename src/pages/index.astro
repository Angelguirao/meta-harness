---
import BaseLayout from "../layouts/BaseLayout.astro";
import { PARTS, PEERS, LANES, peersInLane } from "../data/landscape.js";

const tbd = PEERS.find((p) => p.self);
const fieldLanes = LANES.filter((l) => peersInLane(l.id).length > 0);
---

<BaseLayout>
  <header class="top">
    <span class="top-meta">research · v0</span>
    <nav class="top-nav" aria-label="On this page">
      <a href="#why">why</a>
      <a href="#organs">organs</a>
      <a href="#field">field</a>
      <a href="#tbd">tbd</a>
      <a href="https://github.com/Angelguirao/meta-harness">github</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero">
      <h1 class="brand">meta-harness</h1>
      <p class="lede">
        The coding agent is the muscle. Something else has to be the shop —
        or you are.
      </p>
      <pre class="stack" aria-hidden="true"><code>shop     continuity · scope · constraint · work · retrieve · swap
muscle   claude code · codex · pi · open code · …</code></pre>
    </section>

    <section class="prose" id="why" aria-labelledby="why-title">
      <h2 id="why-title">Why</h2>
      <p>
        A harness runs one loop in one tree. Cancel-order needs API + web +
        design-system — three trees. You clone, paste context, land three PRs.
        That stitching is the job
        <a href="https://metaharness.tools/">metaharness.tools</a> calls a
        meta-harness.
      </p>
      <p>
        Second failure: git keeps the what; the session keeps the why. Chat
        ends, decision vanishes, next Tuesday starts cold.
      </p>
      <p>
        The word splits two ways. <strong>Orchestration</strong> sits above
        many harnesses (cross-repo, memory, swap, policy).
        <strong>Optimization</strong> searches over harness <em>code</em>
        (Stanford). This notebook is about the first — read as a
        <strong>bundle of organs</strong>, not one SKU.
      </p>
      <p class="punch">Maps the field. Not a product. Not a pitch.</p>
    </section>

    <section class="organs" id="organs" aria-labelledby="organs-title">
      <h2 id="organs-title">Organs</h2>
      <p class="section-dek">Missing organ → failure mode.</p>
      <ul class="organ-list">
        {
          PARTS.map((part) => (
            <li>
              <span class="organ-name">{part.label}</span>
              <span class="organ-miss">{part.miss}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="field" id="field" aria-labelledby="field-title">
      <h2 id="field-title">Field</h2>
      <p class="section-dek">
        Primary-source hooks. Tags = our organ frame, not their marketing.
      </p>

      {
        fieldLanes.map((lane) => (
          <div class="lane">
            <h3 class="lane-title">{lane.title}</h3>
            <ul class="peer-list">
              {peersInLane(lane.id).map((p) => (
                <li>
                  <div class="peer-head">
                    <a
                      class="peer-name"
                      href={p.url}
                      target="_blank"
                      rel="noreferrer"
                    >
                      {p.name}
                    </a>
                    {p.by !== p.name ? (
                      <span class="peer-by">{p.by}</span>
                    ) : null}
                    <span class="peer-organs">{p.organs.join(" · ")}</span>
                  </div>
                  <p class="peer-hook">{p.hook}</p>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    {
      tbd && (
        <section class="tbd" id="tbd" aria-labelledby="tbd-title">
          <h2 id="tbd-title">TBD</h2>
          <p class="section-dek">Private. Unlinked. Unclaimed.</p>
          <dl class="tbd-cut">
            <div>
              <dt>lane</dt>
              <dd>Org / workspace OS — not Polygraph, not Omnigent.</dd>
            </div>
            <div>
              <dt>heavy</dt>
              <dd>Control plane + durable meaning.</dd>
            </div>
            <div>
              <dt>thin</dt>
              <dd>Cross-repo scope · trusted handoff · OS sandbox.</dd>
            </div>
            <div class="tbd-open">
              <dt>bet</dt>
              <dd>
                Harden one thin organ — or keep the asset as the world model
                that dispatches wraps.
              </dd>
            </div>
          </dl>
        </section>
      )
    }

    <section class="open" id="open" aria-labelledby="open-title">
      <h2 id="open-title">Open</h2>
      <ol>
        <li>
          After a three-repo change, what stays queryable next week without
          re-explaining the why?
        </li>
        <li>Next thin organ: handoff, sandbox, or scope?</li>
        <li>
          If Polygraph + Omnigent + Beads + retrieve covered the week, what is
          a private control plane still for?
        </li>
      </ol>
    </section>
  </main>

  <footer class="foot">
    <p class="foot-sources">
      <a href="https://metaharness.tools/">metaharness.tools</a>
      <a href="https://trypolygraph.com/">Polygraph</a>
      <a href="https://omnigent.ai/">Omnigent</a>
      <a href="https://paperclip.ing/">Paperclip</a>
      <a href="https://blog.cloudflare.com/cloudflare-os/">Cloudflare OS</a>
      <a href="https://www.agno.com/">Agno</a>
      <a href="https://beads.gascity.com/">Beads</a>
      <a href="https://qm.ycombinator.com/">QM</a>
      <a href="https://www.cerebras.ai/blog/how-we-built-our-knowledge-base"
        >Cerebras</a
      >
      <a href="https://yoonholee.com/meta-harness/">Stanford</a>
      <a href="https://superagenticai.github.io/metaharness/">SuperagenticAI</a>
      <a href="https://github.com/andrewyng/openworker">OpenWorker</a>
    </p>
    <p class="foot-meta">
      Updated 2026-08-07 · labels move · MIT ·
      <a href="https://github.com/Angelguirao/meta-harness">source</a>
    </p>
  </footer>

  <script>
    const links = [...document.querySelectorAll(".top-nav a[href^='#']")];
    const sections = links
      .map((a) => document.querySelector(a.getAttribute("href") || ""))
      .filter(Boolean);

    const sync = () => {
      const y = window.scrollY + 96;
      let current = sections[0];
      for (const s of sections) {
        if (s instanceof HTMLElement && s.offsetTop <= y) current = s;
      }
      links.forEach((a) => {
        a.classList.toggle(
          "is-active",
          current instanceof HTMLElement &&
            a.getAttribute("href") === `#${current.id}`,
        );
      });
    };

    sync();
    window.addEventListener("scroll", sync, { passive: true });
  </script>
</BaseLayout>
