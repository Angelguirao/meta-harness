---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  PARTS,
  PEERS,
  LANES,
  TWO_SHOPS,
  peersInLane,
} from "../data/landscape.js";

/** @type {typeof PEERS} */
const tbd = PEERS.find((p) => p.self);
const [poly, omni] = TWO_SHOPS;

const neighbors = LANES.filter((l) => !l.quiet).flatMap((l) =>
  peersInLane(l.id).map((p) => ({ ...p, laneTitle: l.title })),
);
const elsewhere = LANES.filter((l) => l.quiet).flatMap((l) =>
  peersInLane(l.id).map((p) => ({ ...p, laneTitle: l.title })),
);
---

<BaseLayout>
  <header class="top">
    <span class="top-meta">research · v0</span>
    <nav class="top-nav" aria-label="On this page">
      <a href="#why">why</a>
      <a href="#organs">organs</a>
      <a href="#shops">shops</a>
      <a href="#field">field</a>
      <a href="#tbd">tbd</a>
      <a href="https://github.com/Angelguirao/meta-harness">github</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero">
      <h1 class="brand">meta-harness</h1>
      <p class="lede">
        The coding agent is the muscle. Something else has to be the shop —
        or you are.
      </p>
      <div class="stack" aria-label="Shop over muscle">
        <div class="stack-row">
          <span class="stack-k">shop</span>
          <span class="stack-v">
            {
              PARTS.map((p, i) => (
                <>
                  {i > 0 ? " · " : ""}
                  <a href={`#organ-${p.id}`}>{p.label}</a>
                </>
              ))
            }
          </span>
        </div>
        <div class="stack-row">
          <span class="stack-k">muscle</span>
          <span class="stack-v">claude code · codex · pi · open code · …</span>
        </div>
      </div>
    </section>

    <section class="prose" id="why" aria-labelledby="why-title">
      <h2 id="why-title">Why</h2>
      <p>
        A harness runs one loop in one tree. Cancel-order needs API + web +
        design-system — three trees. You clone, paste context, land three PRs.
        That stitching is what{" "}
        <a href="https://metaharness.tools/">metaharness.tools</a> means by
        meta-harness.
      </p>
      <p>
        And when the chat dies, the why dies with it. Git kept the patch. Nobody
        kept the decision. Next Tuesday starts cold.
      </p>
      <p class="punch">
        Two shops are forming around that gap. Everything else is an organ, an
        org OS, or a different job.
      </p>
    </section>

    <section class="organs" id="organs" aria-labelledby="organs-title">
      <h2 id="organs-title">Organs</h2>
      <p class="section-dek">
        Lens for reading the field — failure modes, not a feature sheet.
      </p>
      <ul class="organ-list">
        {
          PARTS.map((part) => (
            <li id={`organ-${part.id}`}>
              <span class="organ-name">{part.label}</span>
              <span class="organ-miss">{part.miss}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="shops" id="shops" aria-labelledby="shops-title">
      <h2 id="shops-title">Two shops</h2>
      <p class="section-dek">
        Orchestration, today — same layer, different center of gravity.
      </p>
      <div class="shop-grid">
        <article class="shop">
          <header class="shop-head">
            <a
              class="shop-name"
              href={poly.url}
              target="_blank"
              rel="noreferrer">{poly.name}</a
            >
            <span class="shop-by">{poly.by}</span>
          </header>
          <p class="shop-claim">{poly.claim}</p>
          <p class="shop-hook">{poly.hook}</p>
          <p class="shop-organs">
            {
              poly.organs.map((id, i) => (
                <>
                  {i > 0 ? " · " : ""}
                  <a href={`#organ-${id}`}>{id}</a>
                </>
              ))
            }
          </p>
        </article>
        <div class="shop-vs" aria-hidden="true">vs</div>
        <article class="shop">
          <header class="shop-head">
            <a
              class="shop-name"
              href={omni.url}
              target="_blank"
              rel="noreferrer">{omni.name}</a
            >
            <span class="shop-by">{omni.by}</span>
          </header>
          <p class="shop-claim">{omni.claim}</p>
          <p class="shop-hook">{omni.hook}</p>
          <p class="shop-organs">
            {
              omni.organs.map((id, i) => (
                <>
                  {i > 0 ? " · " : ""}
                  <a href={`#organ-${id}`}>{id}</a>
                </>
              ))
            }
          </p>
        </article>
      </div>
      <p class="shops-note">
        Polygraph starts from <em>repos + memory</em>. Omnigent starts from{" "}
        <em>harness swap + policy</em>. Neither is the whole organ bundle.
      </p>

      <aside class="compose" aria-labelledby="compose-title">
        <h3 id="compose-title" class="compose-title">One way to compose</h3>
        <pre class="compose-pre"><code>Polygraph     scope · continuity
Beads         work
Cerebras-like retrieve
Omnigent      swap · constraint   ← if you need rails across CLIs

TBD today     control plane + durable meaning
              (scope · handoff · sandbox still thin)</code></pre>
        <p class="compose-note">
          Organs can be bought separately. The open question is which thin gap
          becomes the product — or whether the world model stays the asset.
        </p>
      </aside>
    </section>

    <section class="field" id="field" aria-labelledby="field-title">
      <h2 id="field-title">Around the shop</h2>
      <p class="section-dek">Neighbors. Not interchangeable with the two above.</p>
      <ul class="peer-list peer-list-dense">
        {
          neighbors.map((p) => (
            <li>
              <div class="peer-head">
                <a
                  class="peer-name"
                  href={p.url}
                  target="_blank"
                  rel="noreferrer"
                >
                  {p.name}
                </a>
                <span class="peer-by">{p.laneTitle}</span>
                <span class="peer-organs">{p.organs.join(" · ")}</span>
              </div>
              <p class="peer-hook">{p.hook}</p>
            </li>
          ))
        }
      </ul>

      {
        elsewhere.length > 0 && (
          <div class="elsewhere">
            <h3 class="lane-title">Elsewhere</h3>
            <ul class="peer-list peer-list-dense">
              {elsewhere.map((p) => (
                <li>
                  <div class="peer-head">
                    <a
                      class="peer-name"
                      href={p.url}
                      target="_blank"
                      rel="noreferrer"
                    >
                      {p.name}
                    </a>
                    <span class="peer-by">{p.laneTitle}</span>
                  </div>
                  <p class="peer-hook">{p.hook}</p>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </section>

    {
      tbd && (
        <section class="tbd" id="tbd" aria-labelledby="tbd-title">
          <h2 id="tbd-title">TBD</h2>
          <p class="section-dek">Private stack. Unlinked. Unclaimed.</p>
          <dl class="tbd-cut">
            <div>
              <dt>lane</dt>
              <dd>Org / workspace OS — not Polygraph, not Omnigent.</dd>
            </div>
            <div>
              <dt>heavy</dt>
              <dd>Control plane + durable meaning.</dd>
            </div>
            <div>
              <dt>thin</dt>
              <dd>Cross-repo scope · trusted handoff · OS sandbox.</dd>
            </div>
            <div class="tbd-open">
              <dt>bet</dt>
              <dd>
                Harden one thin organ — or keep the asset as the world model
                that dispatches wraps.
              </dd>
            </div>
          </dl>
          <ol class="tbd-open-q">
            <li>
              After a three-repo change, what stays queryable next week without
              re-explaining the why?
            </li>
            <li>Next thin organ: handoff, sandbox, or scope?</li>
            <li>
              If Polygraph + Omnigent + Beads + retrieve covered the week, what
              is a private control plane still for?
            </li>
          </ol>
        </section>
      )
    }
  </main>

  <footer class="foot">
    <p class="foot-sources">
      <a href="https://metaharness.tools/">metaharness.tools</a>
      <a href="https://trypolygraph.com/">Polygraph</a>
      <a href="https://omnigent.ai/">Omnigent</a>
      <a href="https://paperclip.ing/">Paperclip</a>
      <a href="https://blog.cloudflare.com/cloudflare-os/">Cloudflare OS</a>
      <a href="https://www.agno.com/">Agno</a>
      <a href="https://beads.gascity.com/">Beads</a>
      <a href="https://qm.ycombinator.com/">QM</a>
      <a href="https://www.cerebras.ai/blog/how-we-built-our-knowledge-base"
        >Cerebras</a
      >
      <a href="https://yoonholee.com/meta-harness/">Stanford</a>
      <a href="https://superagenticai.github.io/metaharness/">SuperagenticAI</a>
      <a href="https://github.com/andrewyng/openworker">OpenWorker</a>
    </p>
    <p class="foot-meta">
      Updated 2026-08-07 · labels move · MIT ·
      <a href="https://github.com/Angelguirao/meta-harness">source</a>
    </p>
  </footer>

  <script>
    const links = [...document.querySelectorAll(".top-nav a[href^='#']")];
    const sections = links
      .map((a) => document.querySelector(a.getAttribute("href") || ""))
      .filter(Boolean);

    const sync = () => {
      const y = window.scrollY + 96;
      let current = sections[0];
      for (const s of sections) {
        if (s instanceof HTMLElement && s.offsetTop <= y) current = s;
      }
      links.forEach((a) => {
        a.classList.toggle(
          "is-active",
          current instanceof HTMLElement &&
            a.getAttribute("href") === `#${current.id}`,
        );
      });
    };

    sync();
    window.addEventListener("scroll", sync, { passive: true });
  </script>
</BaseLayout>
