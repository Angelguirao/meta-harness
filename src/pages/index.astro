---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  PARTS,
  PEERS,
  LANES,
  TWO_SHOPS,
  peersInLane,
} from "../data/landscape.js";

const tbd = PEERS.find((p) => p.self);
const [poly, omni] = TWO_SHOPS;

const neighbors = LANES.filter((l) => !l.quiet).flatMap((l) =>
  peersInLane(l.id).map((p) => ({ ...p, laneTitle: l.title })),
);
const elsewhere = LANES.filter((l) => l.quiet).flatMap((l) =>
  peersInLane(l.id).map((p) => ({ ...p, laneTitle: l.title })),
);
---

<BaseLayout>
  <header class="top">
    <span class="top-meta">research · v0</span>
    <nav class="top-nav" aria-label="On this page">
      <a href="#organs">organs</a>
      <a href="#shops">shops</a>
      <a href="#field">field</a>
      <a href="#tbd">tbd</a>
      <a href="https://github.com/Angelguirao/meta-harness">github</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero">
      <h1 class="brand">meta-harness</h1>
      <p class="lede">
        The coding agent is the muscle. Something else has to be the shop —
        or you are.
      </p>
      <div class="stack" aria-label="Shop over muscle">
        <div class="stack-row">
          <span class="stack-k">shop</span>
          <span class="stack-v">
            {
              PARTS.map((p, i) => (
                <>
                  {i > 0 ? " · " : ""}
                  <a href={`#organ-${p.id}`} data-organ={p.id}>{p.label}</a>
                </>
              ))
            }
          </span>
        </div>
        <div class="stack-row">
          <span class="stack-k">muscle</span>
          <span class="stack-v"
            >claude code · codex · pi · open code · …<span class="cursor" aria-hidden="true"
            ></span></span
          >
        </div>
      </div>
    </section>

    <section class="prose" id="why" aria-labelledby="why-title">
      <h2 id="why-title" class="sr-only">Why</h2>
      <p>
        A harness runs one loop in one tree. Cancel-order needs three. You
        stitch PRs by hand. Then the chat dies — and the why dies with it.
        <a href="https://metaharness.tools/">metaharness.tools</a> named the
        gap; two shops are forming inside it.
      </p>
    </section>

    <section class="organs" id="organs" aria-labelledby="organs-title">
      <h2 id="organs-title">Organs</h2>
      <p class="section-dek">If it’s missing, this breaks.</p>
      <ul class="organ-list">
        {
          PARTS.map((part) => (
            <li id={`organ-${part.id}`} data-organ-row={part.id}>
              <span class="organ-name">{part.label}</span>
              <span class="organ-miss">{part.miss}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="shops" id="shops" aria-labelledby="shops-title">
      <h2 id="shops-title">Two shops</h2>
      <p class="section-dek">Same layer. Different center of gravity.</p>
      <div class="shop-grid">
        <article class="shop" data-organs={poly.organs.join(" ")}>
          <header class="shop-head">
            <a
              class="shop-name"
              href={poly.url}
              target="_blank"
              rel="noreferrer">{poly.name}</a
            >
            <span class="shop-by">{poly.by}</span>
          </header>
          <p class="shop-claim">{poly.claim}</p>
          <p class="shop-hook">{poly.hook}</p>
          <p class="shop-organs">
            {
              poly.organs.map((id, i) => (
                <>
                  {i > 0 ? " · " : ""}
                  <a href={`#organ-${id}`} data-organ={id}>
                    {id}
                  </a>
                </>
              ))
            }
          </p>
        </article>
        <div class="shop-vs" aria-hidden="true">vs</div>
        <article class="shop" data-organs={omni.organs.join(" ")}>
          <header class="shop-head">
            <a
              class="shop-name"
              href={omni.url}
              target="_blank"
              rel="noreferrer">{omni.name}</a
            >
            <span class="shop-by">{omni.by}</span>
          </header>
          <p class="shop-claim">{omni.claim}</p>
          <p class="shop-hook">{omni.hook}</p>
          <p class="shop-organs">
            {
              omni.organs.map((id, i) => (
                <>
                  {i > 0 ? " · " : ""}
                  <a href={`#organ-${id}`} data-organ={id}>
                    {id}
                  </a>
                </>
              ))
            }
          </p>
        </article>
      </div>

      <aside class="compose" aria-labelledby="compose-title">
        <h3 id="compose-title" class="compose-title">One way to compose</h3>
        <ul class="compose-stack">
          <li>
            <a class="compose-who" href={poly.url} target="_blank" rel="noreferrer"
              >Polygraph</a
            >
            <span class="compose-organs">
              {
                poly.organs.map((id, i) => (
                  <>
                    {i > 0 ? " · " : ""}
                    <a href={`#organ-${id}`} data-organ={id}>
                      {id}
                    </a>
                  </>
                ))
              }
            </span>
          </li>
          <li>
            <a
              class="compose-who"
              href="https://beads.gascity.com/"
              target="_blank"
              rel="noreferrer">Beads</a
            >
            <span class="compose-organs">
              <a href="#organ-work" data-organ="work">work</a>
            </span>
          </li>
          <li>
            <a
              class="compose-who"
              href="https://www.cerebras.ai/blog/how-we-built-our-knowledge-base"
              target="_blank"
              rel="noreferrer">Cerebras-like</a
            >
            <span class="compose-organs">
              <a href="#organ-retrieve" data-organ="retrieve">retrieve</a>
            </span>
          </li>
          <li>
            <a class="compose-who" href={omni.url} target="_blank" rel="noreferrer"
              >Omnigent</a
            >
            <span class="compose-organs">
              {
                ["swap", "constraint"].map((id, i) => (
                  <>
                    {i > 0 ? " · " : ""}
                    <a href={`#organ-${id}`} data-organ={id}>
                      {id}
                    </a>
                  </>
                ))
              }
            </span>
            <span class="compose-aside">if you need rails across CLIs</span>
          </li>
          <li class="compose-tbd">
            <span class="compose-who">TBD today</span>
            <span class="compose-organs">control plane + durable meaning</span>
            <span class="compose-aside"
              >scope · handoff · sandbox still thin</span
            >
          </li>
        </ul>
        <p class="compose-note">
          Organs ship separately. The bet is which thin gap becomes the product —
          or whether the world model stays the asset.
        </p>
      </aside>
    </section>

    <section class="field" id="field" aria-labelledby="field-title">
      <h2 id="field-title">Around the shop</h2>
      <p class="section-dek">Neighbors — not the same job as the two above.</p>
      <ul class="peer-list peer-list-dense">
        {
          neighbors.map((p) => (
            <li>
              <div class="peer-head">
                <a
                  class="peer-name"
                  href={p.url}
                  target="_blank"
                  rel="noreferrer"
                >
                  {p.name}
                </a>
                <span class="peer-by">{p.laneTitle}</span>
                <span class="peer-organs">
                  {
                    p.organs.map((id, i) => (
                      <>
                        {i > 0 ? " · " : ""}
                        <a href={`#organ-${id}`} data-organ={id}>
                          {id}
                        </a>
                      </>
                    ))
                  }
                </span>
              </div>
              <p class="peer-hook">{p.hook}</p>
            </li>
          ))
        }
      </ul>
      <p class="elsewhere-line">
        Elsewhere:{" "}
        {
          elsewhere.map((p, i) => (
            <>
              {i > 0 ? " · " : ""}
              <a href={p.url} target="_blank" rel="noreferrer">
                {p.name}
              </a>
            </>
          ))
        }
        {" "}
        — optimization or adjacent, not the shop.
      </p>
    </section>

    {
      tbd && (
        <section class="tbd" id="tbd" aria-labelledby="tbd-title">
          <h2 id="tbd-title">TBD</h2>
          <p class="section-dek">Private. Unlinked. Unclaimed.</p>
          <dl class="tbd-cut">
            <div>
              <dt>lane</dt>
              <dd>Org OS — not Polygraph, not Omnigent.</dd>
            </div>
            <div>
              <dt>heavy</dt>
              <dd>Control plane + durable meaning.</dd>
            </div>
            <div>
              <dt>thin</dt>
              <dd>Scope · trusted handoff · OS sandbox.</dd>
            </div>
            <div class="tbd-open">
              <dt>bet</dt>
              <dd>
                Harden one thin organ — or keep the world model that dispatches
                wraps.
              </dd>
            </div>
          </dl>
        </section>
      )
    }
  </main>

  <footer class="foot">
    <p class="foot-sources">
      <a href="https://metaharness.tools/">metaharness.tools</a>
      <a href="https://trypolygraph.com/">Polygraph</a>
      <a href="https://omnigent.ai/">Omnigent</a>
      <a href="https://paperclip.ing/">Paperclip</a>
      <a href="https://blog.cloudflare.com/cloudflare-os/">Cloudflare OS</a>
      <a href="https://www.agno.com/">Agno</a>
      <a href="https://beads.gascity.com/">Beads</a>
      <a href="https://qm.ycombinator.com/">QM</a>
      <a href="https://www.cerebras.ai/blog/how-we-built-our-knowledge-base"
        >Cerebras</a
      >
      <a href="https://yoonholee.com/meta-harness/">Stanford</a>
      <a href="https://superagenticai.github.io/metaharness/">SuperagenticAI</a>
      <a href="https://github.com/andrewyng/openworker">OpenWorker</a>
    </p>
    <p class="foot-meta">
      Updated 2026-08-07 · labels move · MIT ·
      <a href="https://github.com/Angelguirao/meta-harness">source</a>
    </p>
  </footer>

  <script>
    const links = [...document.querySelectorAll(".top-nav a[href^='#']")];
    const sections = links
      .map((a) => document.querySelector(a.getAttribute("href") || ""))
      .filter(Boolean);

    const sync = () => {
      const y = window.scrollY + 96;
      let current = sections[0];
      for (const s of sections) {
        if (s instanceof HTMLElement && s.offsetTop <= y) current = s;
      }
      links.forEach((a) => {
        a.classList.toggle(
          "is-active",
          current instanceof HTMLElement &&
            a.getAttribute("href") === `#${current.id}`,
        );
      });
    };

    sync();
    window.addEventListener("scroll", sync, { passive: true });

    const paintLit = (ids) => {
      document.querySelectorAll("[data-organ-row]").forEach((row) => {
        const id = row.getAttribute("data-organ-row");
        row.classList.toggle("is-lit", id != null && ids.includes(id));
      });
      document.querySelectorAll("[data-organ]").forEach((tag) => {
        const id = tag.getAttribute("data-organ");
        tag.classList.toggle("is-lit", id != null && ids.includes(id));
      });
    };

    const clearLitSoon = () => {
      requestAnimationFrame(() => {
        const over = document.querySelector(
          "[data-organ]:hover, .shop[data-organs]:hover",
        );
        if (!over && !document.activeElement?.hasAttribute?.("data-organ")) {
          paintLit([]);
        }
      });
    };

    document.querySelectorAll("[data-organ]").forEach((el) => {
      const id = el.getAttribute("data-organ");
      if (!id) return;
      el.addEventListener("pointerenter", () => paintLit([id]));
      el.addEventListener("pointerleave", clearLitSoon);
      el.addEventListener("focus", () => paintLit([id]));
      el.addEventListener("blur", clearLitSoon);
    });

    document.querySelectorAll(".shop[data-organs]").forEach((shop) => {
      const ids = (shop.getAttribute("data-organs") || "")
        .split(/\s+/)
        .filter(Boolean);
      shop.addEventListener("pointerenter", () => paintLit(ids));
      shop.addEventListener("pointerleave", clearLitSoon);
    });
  </script>
</BaseLayout>
